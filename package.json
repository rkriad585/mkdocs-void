{
  "name": "mkdocs-void",
  "version": "0.3.0",
  "description": "Void is a new design language for MkDocs themes: a drop-in theme (name: void) and companion plugin on top of MkDocs.",
  "keywords": [
    "mkdocs",
    "theme",
    "documentation",
    "glass",
    "nothingos",
    "void"
  ],
  "homepage": "https://github.com/rkriad585/mkdocs-void",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node tools/build.js",
    "dev": "node tools/build.js --dev",
    "start": "node tools/build.js --watch",
    "test": "node tests/void.test.js"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.23",
    "axe-core": "^4.13.0",
    "chokidar": "^5.0.0",
    "cssnano": "^6.0.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.6",
    "sass": "^1.97.2"
  },
  "engines": {
    "node": ">= 18"
  }
}
